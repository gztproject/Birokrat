<!DOCTYPE html>
<html lang="{{ app.request.locale }}" data-bs-theme="light">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <title>{% block title %}GZT Birokrat{% endblock %}</title>
        <script>
            (function () {
                try {
                    var mode = localStorage.getItem('birokrat-theme') || 'system';
                    var theme = (mode === 'dark' || mode === 'light')
                        ? mode
                        : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
                    document.documentElement.setAttribute('data-bs-theme', theme);
                } catch (e) {}
            })();
        </script>

        {% block stylesheets %}
            {{ encore_entry_link_tags('css/app') }}
            {{ encore_entry_link_tags('css/copyleft') }}
        {% endblock %}

        <link rel="icon" type="image/x-icon" href="{{ asset('favicon.ico') }}" />
    </head>

    <body id="{% block body_id %}{% endblock %}" class="app-body" data-controller="confirm{% block body_controllers %}{% endblock %}" data-action="submit->confirm#intercept" {% block body_attr %}{% endblock %}>
        {% set current_route = app.request.attributes.get('_route') %}
        {% block header %}{% endblock %}

        {% block body %}
            <div class="app-shell">
                {% if app.user %}
                    <aside class="app-sidenav d-none d-lg-flex" aria-label="{{ 'menu.toggle_nav'|trans }}">
                        {{ include('components/_app_nav.html.twig') }}
                    </aside>
                {% endif %}

                <div class="app-content">
                    {% if app.user %}
                        <header class="app-topbar d-lg-none">
                            <button class="btn btn-outline-secondary" type="button" data-bs-toggle="offcanvas" data-bs-target="#navOffcanvas" aria-controls="navOffcanvas" aria-label="{{ 'menu.toggle_nav'|trans }}">
                                <i class="fa fa-bars" aria-hidden="true"></i>
                            </button>
                            <a href="{{ path('dashboard_index') }}" class="app-brand">
                                Birokrat
                                {% if app.environment == 'dev' %}
                                    <span class="env-badge">DEV</span>
                                {% endif %}
                            </a>
                        </header>
                    {% else %}
                        <header class="app-topbar">
                            <a href="{{ path('dashboard_index') }}" class="app-brand">Birokrat</a>
                            {{ include('components/_topbar_actions.html.twig') }}
                        </header>
                    {% endif %}

                    <main class="app-main">
                        {{ include('default/_flash_messages.html.twig') }}
                        {% block toolbar %}{% endblock %}
                        {% set filter_html %}{% block filters %}{% endblock %}{% endset %}
                        {% if filter_html|trim is not empty %}
                            {{ include('components/_filter_bar.html.twig', { content: filter_html }) }}
                        {% endif %}
                        {% block main %}{% endblock %}
                    </main>

                    {% block footer %}
                        {{ include('components/_footer.html.twig') }}
                    {% endblock %}
                </div>
            </div>

            {% if app.user %}
                <div class="offcanvas offcanvas-start" tabindex="-1" id="navOffcanvas" aria-labelledby="navOffcanvasLabel">
                    <div class="offcanvas-header">
                        <h2 class="offcanvas-title h5" id="navOffcanvasLabel">Birokrat</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="{{ 'label.close'|trans }}"></button>
                    </div>
                    <div class="offcanvas-body">
                        {{ include('components/_app_nav.html.twig') }}
                    </div>
                </div>
            {% endif %}
        {% endblock %}

        {% block sidebar %}{% endblock %}

        {{ include('_notificationModal.html.twig') }}
        {% block javascripts %}
            {{ encore_entry_script_tags('js/app') }}
        {% endblock %}
    </body>
</html>
