{% set native = native|default({})|merge({
    class: ((native.class|default('')) ~ ' form-control sl-date-native')|trim,
    'data-sl-date-target': 'native',
    tabindex: '-1',
    'data-action': ((native['data-action']|default('')) ~ ' input->sl-date#onNativeChange change->sl-date#onNativeChange focus->sl-date#onNativeFocus')|trim,
}) %}
{% set native_input %}
<input type="date"{% for name, value in native %} {{ name }}="{{ value|e('html_attr') }}"{% endfor %}>
{% endset %}
{{ include('components/_sl_date_field.html.twig', { native_input: native_input }) }}
