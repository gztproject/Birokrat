<div class="sl-date" data-controller="sl-date">
    <input type="text"
           class="form-control sl-date-display"
           data-sl-date-target="display"
           data-action="focus->sl-date#onDisplayFocus input->sl-date#onDisplayInput blur->sl-date#onDisplayBlur"
           placeholder="d. m. llll"
           autocomplete="off"
           inputmode="decimal">
    <span class="sl-date-icon" aria-hidden="true"><i class="fa fa-calendar"></i></span>
    {% set native = native|merge({
        class: ((native.class|default('')) ~ ' form-control sl-date-native')|trim,
        'data-sl-date-target': 'native',
        tabindex: '-1',
        'data-action': ((native['data-action']|default('')) ~ ' input->sl-date#onNativeChange change->sl-date#onNativeChange click->sl-date#openPicker')|trim
    }) %}
    <input type="date"{% for name, value in native %} {{ name }}="{{ value|e('html_attr') }}"{% endfor %}>
</div>
