{% set dropup = dropup|default(false) %}
{% set toggle_class = toggle_class|default('nav-link dropdown-toggle') %}
{% set menu_class = menu_class|default('dropdown-menu dropdown-menu-end') %}
{% set static_menu = static_menu|default(false) %}

{% if app.user %}
    <div class="{{ dropup ? 'dropup' : 'dropdown' }}">
        <a href="#" class="{{ toggle_class }}" data-bs-toggle="dropdown"{% if static_menu %} data-bs-display="static"{% endif %} aria-expanded="false">
            <i class="fa fa-globe" aria-hidden="true"></i>
            <span>{{ app.request.locale }}</span>
        </a>
        <div class="{{ menu_class }}">
            {% for locale in locales|split('|') %}
                <a class="dropdown-item" {% if app.request.locale == locale %}aria-checked="true"{% else %}aria-checked="false"{% endif %}
                    href="{{ path(app.request.attributes.get('_route', 'dashboard_index'), app.request.attributes.get('_route_params', {})|merge({_locale: locale})) }}">
                    {{ locale|locale_name|capitalize }}
                </a>
            {% endfor %}
        </div>
    </div>
{% endif %}
