<ul class="navbar-nav app-topbar-actions flex-row">
    <li class="nav-item dropdown" data-controller="theme">
        <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" id="themeMenu">
            <i class="fa fa-adjust" aria-hidden="true"></i>
            <span class="d-none d-md-inline"> {{ 'theme.label'|trans }}</span>
        </a>
        <ul class="dropdown-menu dropdown-menu-end" role="menu" aria-labelledby="themeMenu">
            <li>
                <a class="dropdown-item" href="#" data-theme-target="option" data-theme-value="light" data-action="theme#light" role="menuitemradio">
                    <i class="fa fa-sun" aria-hidden="true"></i> {{ 'theme.light'|trans }}
                </a>
            </li>
            <li>
                <a class="dropdown-item" href="#" data-theme-target="option" data-theme-value="dark" data-action="theme#dark" role="menuitemradio">
                    <i class="fa fa-moon" aria-hidden="true"></i> {{ 'theme.dark'|trans }}
                </a>
            </li>
            <li>
                <a class="dropdown-item" href="#" data-theme-target="option" data-theme-value="system" data-action="theme#system" role="menuitemradio">
                    <i class="fa fa-desktop" aria-hidden="true"></i> {{ 'theme.system'|trans }}
                </a>
            </li>
        </ul>
    </li>
    {% if app.user %}
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fa fa-user" aria-hidden="true"></i>
                <span class="d-none d-md-inline"> {{ app.user.fullname }}</span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end" role="menu">
                <li>
                    <a class="dropdown-item" href="{{ path('user_show', {'id': app.user.id}) }}">
                        <i class="fa fa-edit" aria-hidden="true"></i> {{ 'menu.user'|trans }}
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <a class="dropdown-item" href="{{ path('app_logout') }}">
                        <i class="fa fa-sign-out-alt" aria-hidden="true"></i> {{ 'menu.logout'|trans }}
                    </a>
                </li>
            </ul>
        </li>
        <li class="nav-item dropdown">
            <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" id="locales">
                <i class="fa fa-globe" aria-hidden="true"></i> {{ app.request.locale }}
            </a>
            <div class="dropdown-menu dropdown-menu-end" aria-labelledby="locales">
                {% for locale in locales|split('|') %}
                    <a class="dropdown-item" {% if app.request.locale == locale %}aria-checked="true"{% else %}aria-checked="false"{% endif %}
                        href="{{ path(app.request.attributes.get('_route', 'dashboard_index'), app.request.attributes.get('_route_params', {})|merge({_locale: locale})) }}">
                        {{ locale|locale_name|capitalize }}
                    </a>
                {% endfor %}
            </div>
        </li>
    {% endif %}
</ul>
