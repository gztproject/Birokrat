{% extends 'bootstrap_5_layout.html.twig' %}

{% block date_widget %}
    {%- if widget == 'single_text' and type|default('date') == 'date' -%}
        {%- set attr = attr|merge({
            'data-sl-date-target': 'native',
            tabindex: '-1',
            'data-action': (attr['data-action']|default('') ~ ' input->sl-date#onNativeChange change->sl-date#onNativeChange focus->sl-date#onNativeFocus')|trim,
            class: (attr.class|default('') ~ ' sl-date-native')|trim,
        }) -%}
        {%- set native_input -%}
            {{- parent() -}}
        {%- endset -%}
        {{ include('components/_sl_date_field.html.twig', { native_input: native_input }) }}
    {%- else -%}
        {{- parent() -}}
    {%- endif -%}
{% endblock %}

{% block form_errors -%}
    {% if errors|length > 0 -%}
        {% if form is not rootform %}<div class="invalid-feedback d-block">{% else %}<div class="alert alert-danger">{% endif %}
        <ul class="list-unstyled mb-0">
        {%- for error in errors -%}
            <li><span class="fa fa-exclamation-triangle"></span> {{ error.message }}</li>
        {%- endfor -%}
        </ul>
        {% if form is not rootform %}</div>{% else %}</div>{% endif %}
    {%- endif %}
{%- endblock form_errors %}
