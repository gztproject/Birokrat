{{ form_start(form, {attr: {'data-controller': 'incoming-form'}}) }} 
    <div class="invoice-document" id="IncomingInvoiceFormContainer"> 
        
        <div class="row">
            <div class="col-sm-6">
                <div class="mb-3">                    
                        {{ form_label(form.issuer, null, {'label_attr': {'class': 'col-form-label-lg'}} ) }}
                        <div class='input-group'>
                        {{ form_widget(form.issuer, {'attr': {'class': 'form-control'}}) }}                
                    </div>
                </div>            
            </div>
            <div class="col-sm-6">
                <div class="mb-3">                    
                        {{ form_label(form.number, null, {'label_attr': {'class': 'col-form-label-lg'}} ) }}
                        <div class='input-group'>
                        {{ form_widget(form.number, {'attr': {'class': 'form-control'}}) }}                
                    </div>
                </div>
            </div>     
        </div> 
       
        <div class="row">
            <div class="col-sm-6">
                <div class="mb-3">
                    {{ form_label(form.recepient, null, {'label_attr': {'class': 'col-form-label-lg'}} ) }}
                    <div class='input-group'>
                        {{ form_widget(form.recepient, {'attr': {'class': 'form-control'}}) }}                
                    </div>
                </div>            
            </div> 
            <div class="col-sm-3">
                <div class="mb-3">                   
                        {{ form_label(form.dateOfIssue, null, {'label_attr': {'class': 'col-form-label-lg'}} ) }}
                         <div id="dateOfIssue" class='input-group'>
                        {{ form_widget(form.dateOfIssue, {'attr': {'class': 'form-control'}}) }}
                        
                            <span class="input-group-text"><i class="fa fa-calendar" aria-hidden="true"></i></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-3">
                <div class="mb-3">                   
                        {{ form_label(form.reference, null, {'label_attr': {'class': 'col-form-label-lg'}} ) }}
                         <div id="reference" class='input-group'>
                        {{ form_widget(form.reference, {'attr': {'class': 'form-control'}}) }}                        
                    </div>
                </div>
            </div>                  
        </div>
        
        <div class="row">
            <div class="col-sm-2">  
                <div class="mb-3">                   
                    {{ form_label(form.paidOnSpot, null, {'label_attr': {'class': 'col-form-label-lg'}} ) }}
                    <div id="paidOnSpot" class='input-group'>
                        {{ form_widget(form.paidOnSpot, {'attr': {'class': 'form-control'}}) }}                        
                    </div>
                </div>            
            </div>
            <div class="col-sm-4">  
                <div id="paymentMethod" class="mb-3">                   
                    {{ form_label(form.paymentMethod, null, {'label_attr': {'class': 'col-form-label-lg'}} ) }}
                    <div class='input-group'>
                        {{ form_widget(form.paymentMethod, {'attr': {'class': 'form-control'}}) }}                        
                    </div>
                </div>              
            </div>
            <div class="col-sm-3">
                <div id="dueInDays" class="mb-3">
                    <label class='col-form-label-lg' for='invoice_dueInDays'>{{ 'label.dueInDays' | trans }}</label>
                    <div class='input-group'>
                        <input id='invoice_dueInDays' class='form-control' type='number'>
                        
                            <span class="input-group-text">{{ 'label.days' | trans }}</span>
                        </div>                       
                    </div>
                </div>
            </div>
            <div class="col-sm-3">
                <div id="dueDate" class="mb-3">                    
                        {{ form_label(form.dueDate, null, {'label_attr': {'class': 'col-form-label-lg'}} ) }}
                        <div class='input-group'>
                        {{ form_widget(form.dueDate, {'attr': {'class': 'form-control'}}) }}
                        
                            <span class="input-group-text"><i class="fa fa-calendar" aria-hidden="true"></i></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-6">
                
            </div>
            
        </div>         
       
        <div class="row">
            <div class="col-sm-7"> 
                <div class="mb-3">                   
                        {{ form_label(form.debitKonto, null, {'label_attr': {'class': 'col-form-label-lg'}} ) }}
                         <div id="debitKonto" class='input-group'>
                        {{ form_widget(form.debitKonto, {'attr': {'class': 'form-control'}}) }}                        
                    </div>
                </div>               
            </div>
            <div class="col-sm-2">  
                      
            </div>            
            <div class="col-sm-3">
                <div class="mb-3">                    
                    {{ form_label(form.price, null, {'label_attr': {'class': 'col-form-label-lg'}} ) }}
                    <div id="price" class='input-group'>
                        {{ form_widget(form.price, {'attr': {'class': 'form-control'}}) }}                     
                    </div>
                </div>  
            </div>
        </div>
        <div class="row">
            <div class="col-sm-3">
                <div class="mb-3">
                    {{ form_label(form.bankCost, null, {'label_attr': {'class': 'col-form-label-lg'}} ) }}
                    <div class='input-group'>
                        {{ form_widget(form.bankCost, {'attr': {'class': 'form-control'}}) }}
                    </div>
                </div>
            </div>
            <div class="col-sm-9">
                <div class="mb-3" data-controller="collection" data-collection-min-rows-value="0">
                    {{ form_label(form.allocations, null, {'label_attr': {'class': 'col-form-label-lg'}} ) }}
                    <div data-collection-target="container" data-prototype="{{ ('<div class="row mb-2" data-collection-row>' ~ form_widget(form.allocations.vars.prototype) ~ '<div class="col-sm-1"><button type="button" class="btn btn-sm btn-danger" data-action="collection#remove"><i class="fa fa-minus"></i></button></div></div>')|e('html_attr') }}">
                        {% for allocation in form.allocations %}
                            <div class="row mb-2" data-collection-row>
                                <div class="col-sm-5">{{ form_widget(allocation.konto, {'attr': {'class': 'form-control'}}) }}</div>
                                <div class="col-sm-3">{{ form_widget(allocation.amount, {'attr': {'class': 'form-control'}}) }}</div>
                                <div class="col-sm-3">{{ form_widget(allocation.note, {'attr': {'class': 'form-control'}}) }}</div>
                                <div class="col-sm-1"><button type="button" class="btn btn-sm btn-danger" data-action="collection#remove"><i class="fa fa-minus"></i></button></div>
                            </div>
                        {% endfor %}
                    </div>
                    <button type="button" class="btn btn-sm btn-success" data-action="collection#add">
                        <i class="fa fa-plus"></i> {{ 'label.allocations'|trans }}
                    </button>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-8">
                <div class="mb-3">
                    {{ form_label(form.note, null, {'label_attr': {'class': 'col-form-label-lg'}} ) }}
                    {{ form_widget(form.note, {'attr': {'class': 'form-control'}}) }}
                </div>
            </div>
            <div class="col-sm-4">
                <div class="mb-3">
                    {{ form_label(form.scan, null, {'label_attr': {'class': 'col-form-label-lg'}} ) }}
                    {{ form_widget(form.scan, {'attr': {'class': 'form-control'}}) }}
                </div>
            </div>
        </div>
    
    {% if include_bottom_buttons|default(true) %}
        {{ include('dashboard/incomingInvoice/_form_actions.html.twig', {
        button_label: button_label,
        include_back_to_home_link: include_back_to_home_link,        
    }, with_context = false) }}
    {% endif %}
    </div>

{{ form_row(form._token) }}
{{ form_end(form, {'render_rest': false}) }}