<table class="table table-hover align-middle">
        <thead>
            <tr>
                <th scope="col">{{ 'label.invoiceNumber'|trans }}</th>
                <th scope="col"><i class="fa fa-calendar" aria-hidden="true"></i> {{ 'label.dateOfIssue'|trans }}</th>
                <th scope="col">{{ 'label.issuer'|trans }}</th>
                <th scope="col">{{ 'label.reference'|trans }}</th>
                <th scope="col" class="text-end">{{ 'label.sum'|trans }}</th>
                <th scope="col">{{ 'label.dueDate'|trans }}/{{ 'label.paid'|trans }}</th>
                <th scope="col" class="text-end">{{ 'label.actions'|trans }}</th>
            </tr>
        </thead>
        <tbody>
        {% for invoice in invoices %}
            {% if invoice.State == 00 %}
                {% set rowClass = "table-secondary" %}
                {% set status = "draft" %}
            {% elseif invoice.State == 10 %}
                {% if date() > invoice.dueDate|date_modify("+1 day") %}
                    {% set rowClass = "table-warning" %}
                    {% set status = "overdue" %}
                {% else %}
                    {% set rowClass = "table-info" %}
                    {% set status = "issued" %}
                {% endif %}
            {% elseif invoice.State == 20 %}
                {% set rowClass = "table-success" %}
                {% set status = "paid" %}
            {% elseif invoice.State >= 100 %}
                {% set rowClass = "table-danger" %}
                {% set status = "rejected" %}
            {% else %}
                {% set rowClass = "table-primary" %}
                {% set status = "issued" %}
            {% endif %}
            <tr data-id={{ invoice.id }} class="invoiceRow {{ rowClass }}">
                <td>
                    {{ invoice.number }}
                    {{ include('components/_status_badge.html.twig', { status: status }) }}
                </td>
                <td>{{ invoice.dateOfIssueString }}</td>
                <td>{{ invoice.Issuer.ShortName }}</td>
                <td>{{ invoice.ReferenceNumber }}</td>
                <td class="money">{{ invoice.Price | money}}</td>
                <td>{% if invoice.datePaid %}
                        {{ invoice.DatePaidString }}
                    {% else %}
                         {{ invoice.DueDateString }}
                    {% endif %}
                </td>
                <td class="text-end">
                    {% embed 'components/_action_menu.html.twig' %}
                        {% block primary %}
                            {% if invoice.State == 10 %}
                                <button class="set-paid btn btn-sm btn-success" type="submit" name="id" value={{ invoice.id }}><i class="fa fa-euro-sign" aria-hidden="true"></i>
                                        {{ 'action.setPaid'|trans }}
                                </button>
                                <button class="reject btn btn-sm btn-danger" type="submit" name="id" value={{ invoice.id }}><i class="fa fa-times" aria-hidden="true"></i>
                                        {{ 'action.reject'|trans }}
                                </button>
                            {% endif %}
                        {% endblock %}
                        {% block more %}
                            <li>
                                <a class="dropdown-item" href="{{ path('incomingInvoice_show', {'id': invoice.id}) }}">
                                    <i class="fa fa-eye" aria-hidden="true"></i> {{ 'action.show'|trans }}
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="{{ path('incomingInvoice_clone', {'id': invoice.id}) }}">
                                    <i class="fa fa-copy" aria-hidden="true"></i> {{ 'action.clone'|trans }}
                                </a>
                            </li>
                        {% endblock %}
                    {% endembed %}
                </td>
            </tr>
        {% else %}
            {{ include('components/_empty_state.html.twig', { colspan: 7, message: 'invoice.no_invoices_found'|trans }) }}
        {% endfor %}
    </tbody>
</table>

<div id="rejectReasonModal" class="modal fade" role="dialog" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h4 class="modal-title">{{ 'label.reject_reason'|trans }}</h4>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
            <form>
                <label class="form-label" for="rejectReason">{{ 'label.reject_reason'|trans }}</label>
                <input id="rejectReason" class="form-control" type="text" name="reason">
                <input id="rejectId" type="hidden" name="id">
            </form>
      </div>
      <div class="modal-footer">
        <button id="submitReject" type="submit" class="btn btn-danger"><i class="fa fa-times" aria-hidden="true"></i> {{ 'action.reject'|trans }}</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'label.close'|trans }}</button>
      </div>
    </div>
  </div>
</div>

<div id="dateModal" class="modal fade" role="dialog" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h4 class="modal-title">{{ 'label.date'|trans }}</h4>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
            <form>
            <div class="row">
                <div class="col-md-6 mb-3">
                <label class="form-label" for="modalDate">{{ 'label.date'|trans }}</label>
                <input id="modalDate" class="form-control" type="text" name="date" data-date-format="DD. MM. YYYY" data-date-locale="sl">
                <input id="dateId" type="hidden" name="id">
                </div>
                <div class="col-md-6 mb-3">
                <label class="form-label" for="modalPaymentMethod">{{ 'label.paymentMethod'|trans }}</label>
                <select id="modalPaymentMethod" class="form-select">
                    <option value="00">{{ 'label.cash'|trans}}</option>
                    <option value="10">{{ 'label.transfer'|trans}}</option>
                </select>
                </div>
                </div>
                <div class="mb-0">
                    <label class="form-label" for="modalBankCost">{{ 'label.bankCost'|trans }}</label>
                    <input id="modalBankCost" class="form-control" type="number" step="0.01" name="bankCost" value="0">
                </div>
            </form>
      </div>
      <div class="modal-footer">
        <button id="submitDate" type="submit" class="btn btn-success"><i class="fa fa-check" aria-hidden="true"></i> {{ 'action.OK'|trans }}</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'label.close'|trans }}</button>
      </div>
    </div>
  </div>
</div>
