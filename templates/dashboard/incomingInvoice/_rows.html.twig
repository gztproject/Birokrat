{% for invoice in invoices %}
    {% if invoice.State == 00 %}
        {% set rowClass = "table-secondary" %}
        {% set status = "draft" %}
    {% elseif invoice.State == 10 %}
        {% if date() > invoice.dueDate|date_modify("+1 day") %}
            {% set rowClass = "table-warning" %}
            {% set status = "overdue" %}
        {% else %}
            {% set rowClass = "table-info" %}
            {% set status = "issued" %}
        {% endif %}
    {% elseif invoice.State == 20 %}
        {% set rowClass = "table-success" %}
        {% set status = "paid" %}
    {% elseif invoice.State >= 100 %}
        {% set rowClass = "table-danger" %}
        {% set status = "rejected" %}
    {% else %}
        {% set rowClass = "table-primary" %}
        {% set status = "issued" %}
    {% endif %}
    <tr data-id={{ invoice.id }} class="invoiceRow {{ rowClass }}" data-action="click->document-action#openRow">
        <td class="col-number">
            <span class="doc-number">{{ invoice.number }}</span>
            {{ include('components/_status_badge.html.twig', { status: status }) }}
        </td>
        <td class="col-date">{{ invoice.dateOfIssueString }}</td>
        <td class="col-party">{{ invoice.Issuer.ShortName }}</td>
        <td class="d-none d-lg-table-cell">{{ invoice.ReferenceNumber }}</td>
        <td class="col-sum money">{{ invoice.Price | money}}</td>
        <td class="d-none d-md-table-cell">{% if invoice.datePaid %}
                {{ invoice.DatePaidString }}
            {% else %}
                 {{ invoice.DueDateString }}
            {% endif %}
        </td>
        <td class="col-actions text-end">
            {% embed 'components/_action_menu.html.twig' %}
                {% block primary %}
                    {% if invoice.State == 10 %}
                        <button class="set-paid btn btn-sm btn-success" type="button" name="id" value={{ invoice.id }} data-action="click->document-action#pay"><i class="fa fa-euro-sign" aria-hidden="true"></i>
                                {{ 'action.setPaid'|trans }}
                        </button>
                        <button class="reject btn btn-sm btn-danger" type="button" name="id" value={{ invoice.id }} data-action="click->document-action#reject"><i class="fa fa-times" aria-hidden="true"></i>
                                {{ 'action.reject'|trans }}
                        </button>
                    {% endif %}
                {% endblock %}
                {% block more %}
                    <li>
                        <a class="dropdown-item" href="{{ path('incomingInvoice_show', {'id': invoice.id}) }}">
                            <i class="fa fa-eye" aria-hidden="true"></i> {{ 'action.show'|trans }}
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" href="{{ path('incomingInvoice_clone', {'id': invoice.id}) }}">
                            <i class="fa fa-copy" aria-hidden="true"></i> {{ 'action.clone'|trans }}
                        </a>
                    </li>
                {% endblock %}
            {% endembed %}
        </td>
    </tr>
{% else %}
    {% if empty|default(true) %}
        {{ include('components/_empty_state.html.twig', { colspan: 7, message: 'invoice.no_invoices_found'|trans }) }}
    {% endif %}
{% endfor %}
