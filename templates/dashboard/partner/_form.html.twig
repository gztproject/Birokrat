{% if show_confirmation|default(true) %}
    {% set attr = {'data-confirmation': 'true'} %}
    {{ include ('dashboard/partner/_delete_partner_confirmation.html.twig') }}
{% endif %}

<div class="invoice-document"> 
{{ form_start(form) }}
            
        
        <div class='row'>
            <div class="col-sm-7">
                <div class="mb-3"> 
                    {{ form_label(form.name, null, {'label_attr': {'class': 'col-form-label-lg'}} ) }}
                    <div class='input-group'>
                        {{ form_widget(form.name, {'attr': {'class': 'form-control'}}) }}
                    </div>
                </div>
            </div> 
            <div class="col-sm-5">
                <div class="mb-3"> 
                    {{ form_label(form.shortName, null, {'label_attr': {'class': 'col-form-label-lg'}} ) }}
                    <div class='input-group'>
                        {{ form_widget(form.shortName, {'attr': {'class': 'form-control'}}) }} 
                    </div>
                </div>
            </div>
        </div>
        
        <div class='row'>
            <div class="col-sm-9">
                <div class="mb-3"> 
                    {{ form_label(form.taxNumber, null, {'label_attr': {'class': 'col-form-label-lg'}} ) }}
                    <div class='input-group'>
                        {{ form_widget(form.taxNumber, {'attr': {'class': 'form-control'}}) }}
                    </div>
                </div>
            </div>
            <div class="col-sm-3">
                <div class="mb-3"> 
                    {{ form_label(form.taxable, null, {'label_attr': {'class': 'col-form-label-lg'}} ) }}
                    <div class='input-group'>
                        {{ form_widget(form.taxable, {'attr': {'class': 'form-control'}}) }}
                    </div>
                </div>
            </div>
        </div>
        <div class='row'>
            <div class="col-sm-6">
                <div class="mb-3">
                    {{ form_label(form.isClient, null, {'label_attr': {'class': 'col-form-label-lg'}} ) }}
                    <div class='input-group'>
                        {{ form_widget(form.isClient, {'attr': {'class': 'form-check-input'}}) }}
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="mb-3">
                    {{ form_label(form.isSupplier, null, {'label_attr': {'class': 'col-form-label-lg'}} ) }}
                    <div class='input-group'>
                        {{ form_widget(form.isSupplier, {'attr': {'class': 'form-check-input'}}) }}
                    </div>
                </div>
            </div>
        </div>
        
        <div class='row'> 
            <div class="col-sm-4">
                <div class="mb-3">           
                    {{ form_label(form.address.line1, null, {'label_attr': {'class': 'col-form-label-lg'}} ) }}
                    <div class='input-group'>
                        {{ form_widget(form.address.line1, {'attr': {'class': 'form-control'}}) }} 
                    </div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="mb-3">           
                    {{ form_label(form.address.line2, null, {'label_attr': {'class': 'col-form-label-lg'}} ) }}
                    <div class='input-group'>
                        {{ form_widget(form.address.line2, {'attr': {'class': 'form-control'}}) }} 
                    </div>
                </div>
            </div> 
            <div class="col-sm-4">
                <div class="mb-3">           
                    {{ form_label(form.address.post, null, {'label_attr': {'class': 'col-form-label-lg'}} ) }}
                    <div class='input-group'>
                        {{ form_widget(form.address.post, {'attr': {'class': 'form-control'}}) }} 
                    </div>
                </div>
            </div>
        </div>
        <div class='row'>
            <div class="col-sm-6">
                <div class="mb-3">
                    {{ form_label(form.email, null, {'label_attr': {'class': 'col-form-label-lg'}} ) }}
                    <div class='input-group'>
                        {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
                    </div>
                    {{ form_help(form.email) }}
                </div>
            </div>
            <div class="col-sm-6">
                <div class="mb-3">
                    {{ form_label(form.www, null, {'label_attr': {'class': 'col-form-label-lg'}} ) }}
                    <div class='input-group'>
                        {{ form_widget(form.www, {'attr': {'class': 'form-control'}}) }}
                    </div>
                </div>
            </div>
        </div>
        <div class="mb-3" data-controller="collection" data-collection-min-rows-value="0">
            {{ form_label(form.extraEmailCommands, null, {'label_attr': {'class': 'col-form-label-lg'}} ) }}
            {{ form_help(form.extraEmailCommands) }}
            <div class="row mb-1 small text-muted">
                <div class="col-sm-4">{{ 'label.email'|trans }}</div>
                <div class="col-sm-3">{{ 'label.displayName'|trans }}</div>
                <div class="col-sm-4">{{ 'label.emailRole'|trans }}</div>
            </div>
            <div data-collection-target="container" data-prototype="{{ ('<div class="row mb-2" data-collection-row>' ~ form_widget(form.extraEmailCommands.vars.prototype) ~ '<div class="col-sm-1"><button type="button" class="btn btn-sm btn-danger" data-action="collection#remove"><i class="fa fa-minus"></i></button></div></div>')|e('html_attr') }}">
                {% for extraEmail in form.extraEmailCommands %}
                    <div class="row mb-2" data-collection-row>
                        {{ form_widget(extraEmail) }}
                        <div class="col-sm-1"><button type="button" class="btn btn-sm btn-danger" data-action="collection#remove"><i class="fa fa-minus"></i></button></div>
                    </div>
                {% endfor %}
            </div>
            <button type="button" class="btn btn-sm btn-success mt-1" data-action="collection#add">
                <i class="fa fa-plus"></i> {{ 'label.extraEmails'|trans }}
            </button>
        </div>
        <div class='row'>
            <div class="col-sm-6">
                <div class="mb-3">
                    {{ form_label(form.phone, null, {'label_attr': {'class': 'col-form-label-lg'}} ) }}
                    <div class='input-group'>
                        {{ form_widget(form.phone, {'attr': {'class': 'form-control'}}) }}
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="mb-3">
                    {{ form_label(form.mobile, null, {'label_attr': {'class': 'col-form-label-lg'}} ) }}
                    <div class='input-group'>
                        {{ form_widget(form.mobile, {'attr': {'class': 'form-control'}}) }}
                    </div>
                </div>
            </div>
        </div>
        <div class='row'>
            <div class="col-sm-8">
                <div class="mb-3">
                    {{ form_label(form.accountNumber, null, {'label_attr': {'class': 'col-form-label-lg'}} ) }}
                    <div class='input-group'>
                        {{ form_widget(form.accountNumber, {'attr': {'class': 'form-control'}}) }}
                    </div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="mb-3">
                    {{ form_label(form.bic, null, {'label_attr': {'class': 'col-form-label-lg'}} ) }}
                    <div class='input-group'>
                        {{ form_widget(form.bic, {'attr': {'class': 'form-control'}}) }}
                    </div>
                </div>
            </div>
        </div>
                    
        <div class='row'> 
            <div class="col-sm-3">
                <div class="mb-3">            
                    <button type="submit" class="btn btn-primary">
                        <i class="fa fa-save" aria-hidden="true"></i> {{ button_label|default(('label.save_partner')|trans) }}
                    </button>
                </div>
            </div>
            {% if include_back_to_home_link|default(false) %}
            <div class="col-sm-3">
                <div class="mb-3">
                    <a href="{{ path('partner_index') }}" class="btn btn-primary">
                        <i class="fa fa-list-alt" aria-hidden="true"></i> {{ 'action.back_to_list'|trans }}
                    </a>
                </div>
            </div>
            {% endif %}
        </div>  

{{ form_end(form) }}

</div> 
