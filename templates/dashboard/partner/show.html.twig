{% extends 'dashboard/layout.html.twig' %}

{% block body_id 'partner_show' %}

{% block toolbar %}
    <div class="page-toolbar">
        <h1 class="page-title">{{ partner.name }}</h1>
        <div class="page-toolbar-actions">
            <a href="{{ path('partner_edit', {id: partner.id}) }}" class="btn btn-sm btn-success">
                <i class="fa fa-edit" aria-hidden="true"></i> {{ 'action.edit_contents'|trans }}
            </a>
            {{ include('dashboard/partner/_delete_form.html.twig', {partner: partner}, with_context = false) }}
        </div>
    </div>
{% endblock %}

{% block main %}
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-4">
                <div class="card app-card mb-3"> 
                    <div class="card-header">
                        <strong>{{ ('label.partnerData')|trans }}</strong>
                    </div>    
                    <div class="card-body">                    
                        <strong>{{ 'label.name'|trans }}</strong>: {{ partner.name }}<br>
                        <strong>{{ 'label.email'|trans }}</strong>: {{ partner.email }}<br>
                        {% if partner.extraEmails|length %}
                            <strong>{{ 'label.extraEmails'|trans }}</strong>:
                            <ul class="mb-0">
                                {% for extra in partner.extraEmails %}
                                    <li>
                                        {{ extra.email }}
                                        {% if extra.name %} ({{ extra.name }}){% endif %}
                                        {% if extra.role %} — {{ extra.role }}{% endif %}
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                        <strong>{{ 'label.www'|trans }}</strong>: {{ partner.www }}<br>
                        <strong>{{ 'label.phone'|trans }}</strong>: {{ partner.phone }}<br>
                        <strong>{{ 'label.mobile'|trans }}</strong>: {{ partner.mobile }}<br>
                        <strong>{{ 'label.accountNumber'|trans }}</strong>: {{ partner.accountNumber }}<br>
                        <strong>{{ 'label.bic'|trans }}</strong>: {{ partner.bic }}
                    </div>
                </div>
            </div>
            <div class="col-md-8">
                <div class="card app-card mb-3">   
                    <div class="card-header">
                        <strong>{{ 'label.address'|trans }}</strong>
                    </div> 
                    <div class="card-body">
                        {% for line in partner.address.getFullFormattedAddress %}
                            {{ line }}</br>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
        {% if partner.isClient %}
            <div class="row">
                <div class="col-md-12">
                    <div class="card app-card mb-3">   
                        <div class="card-header">
                            <strong>{{ 'label.invoices'|trans }}</strong>
                        </div>  
                        <div class="card-body">
                            {{ include('dashboard/invoice/_table.html.twig', {
                                invoices: partner.invoices
                            }, with_context = false) }}
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}
        {% if partner.isSupplier %}
            <div class="row">
                <div class="col-md-12">
                    <div class="card app-card mb-3">   
                        <div class="card-header">
                            <strong>{{ 'label.incomingInvoices'|trans }}</strong>
                    </div>  
                        <div class="card-body">
                            {{ include('dashboard/incomingInvoice/_table.html.twig', {
                                invoices: partner.incomingInvoices
                            }, with_context = false) }}
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}  