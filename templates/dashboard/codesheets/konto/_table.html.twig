<div class="list-table-wrap">
<div class="table-responsive">
<table class="table table-hover align-middle" id="konto_table">
    <thead>
        <tr>
            <th scope="col">{{ 'label.number'|trans }}</th>
            <th scope="col"><i class="fa fa-calendar" aria-hidden="true"></i> {{ 'label.name'|trans }}</th>
            <th scope="col" class="text-end"><i class="fa fa-cogs" aria-hidden="true"></i> {{ 'label.actions'|trans }}</th>
        </tr>
    </thead>
    <tbody>
        {% for konto in kontos %}
        <tr>
            <td>{{ konto.fullNumber }}</td>
            <td>{{ konto.name }}</td>
            <td class="text-end">
                <div class="item-actions">
                    <a href="#{#{{ path('admin_user_edit', {'id': konto.id}) }}#}" class="btn btn-sm btn-primary">
                        <i class="fa fa-edit" aria-hidden="true"></i> {{ 'action.edit'|trans }}
                    </a>
                </div>
            </td>
        </tr>
    {% else %}
        {{ include('components/_empty_state.html.twig', { colspan: 3, message: 'konto.no_kontos_found'|trans }) }}
    {% endfor %}
    </tbody>
</table>
</div>
</div>
<div class="list-cards">
    {% for konto in kontos %}
        <div class="list-card">
            <div>
                <div class="list-card-title">{{ konto.fullNumber }}</div>
                <div class="list-card-sub">{{ konto.name }}</div>
            </div>
        </div>
    {% else %}
        <div class="empty-state">{{ 'konto.no_kontos_found'|trans }}</div>
    {% endfor %}
</div>
