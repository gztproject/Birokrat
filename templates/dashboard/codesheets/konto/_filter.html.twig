<div class="filter">
{{ form_start(form, {attr: attr|default({})|merge({
    'data-controller': 'konto-filter',
    'data-action': 'change->konto-filter#onCategoryChange'
}) }) }}
   
    {{ form_errors(form) }}
    <div class="mb-3" id="ClassFilterForm">    
        {{ form_label(form.kontoClasses) }}
        {{ form_widget(form.kontoClasses, {'attr': {'class': 'form-control', 'data-konto-filter-target': 'classSelect', 'data-action': 'change->konto-filter#onClassChange'}}) }}
    </div>
    <div class="mb-3" id="CategoryFilterForm">
        {{ form_label(form.kontoCategories) }}
        {{ form_widget(form.kontoCategories, {'attr': {'class': 'form-control', 'data-konto-filter-target': 'categorySelect'}}) }}
    </div>    
{{ form_end(form) }}
</div>    