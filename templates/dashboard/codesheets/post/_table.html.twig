<table class="table table-hover align-middle" id="post_table">
    <thead>
        <tr>
            <th scope="col">{{ 'label.postName'|trans }}</th>
            <th scope="col">{{ 'label.postCode'|trans }}</th>
            <th scope="col">{{ 'label.postCodeInternational'|trans }}</th>
            <th scope="col" class="text-end"><i class="fa fa-cogs" aria-hidden="true"></i> {{ 'label.actions'|trans }}</th>
        </tr>
    </thead>
    <tbody>
        {% for post in posts %}
        <tr>
            <td>{{ post.name }}</td>
            <td>{{ post.code }}</td>
            <td>{{ post.codeInternational }}</td>
            <td class="text-end">
                <div class="item-actions">
                    <a href="#{#{{ path('admin_user_edit', {'id': post.id}) }}#}" class="btn btn-sm btn-primary">
                        <i class="fa fa-edit" aria-hidden="true"></i> {{ 'action.edit'|trans }}
                    </a>
                </div>
            </td>
        </tr>
    {% else %}
        {{ include('components/_empty_state.html.twig', { colspan: 4, message: 'label.no_posts_found'|trans }) }}
    {% endfor %}
    </tbody>
</table>
