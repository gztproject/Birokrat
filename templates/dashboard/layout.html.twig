{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('css/dashboard') }}
{% endblock %}

{% block header_navigation_links %}
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown" aria-expanded="false" id="invoices">
            <i class="fa fa-receipt" aria-hidden="true"></i>
            {{ 'menu.invoices'|trans }}
        </a>
        <ul class="dropdown-menu" role="menu" aria-labelledby="invoices">
            <li>
                <a class="dropdown-item" href="{{ path('invoice_index') }}">
                    <i class="fa fa-sign-out-alt" aria-hidden="true"></i> {{ 'menu.outgoing'|trans }}
                </a>
            </li>
            <li>
                <a class="dropdown-item" href="{{ path('incomingInvoice_index') }}">
                    <i class="fa fa-sign-in-alt" aria-hidden="true"></i> {{ 'menu.incoming'|trans }}
                </a>
            </li>
        </ul>
    </li>  
    
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown" aria-expanded="false" id="expenses">
            <i class="fas fa-funnel-dollar"></i>
            {{ 'menu.expenses'|trans }}
        </a>        
        <ul class="dropdown-menu" role="menu" aria-labelledby="expenses">
            <li>
                <a class="dropdown-item" href="{{ path('travelExpense_index') }}">
                    <i class="fa fa-map-marked-alt" aria-hidden="true"></i> {{ 'menu.travelExpenses'|trans }}
                </a>
            </li>
            <li>
                <a class="dropdown-item" href="{{ path('lunchExpense_index') }}">
                    <i class="fa fa-utensils" aria-hidden="true"></i> {{ 'menu.lunchExpenses'|trans }}
                </a>
            </li>
        </ul>
    </li>  
    
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown" aria-expanded="false" id="reports">
            <i class="fa fa-file" aria-hidden="true"></i>
            {{ 'menu.reports'|trans }}
        </a>        
        <ul class="dropdown-menu" role="menu" aria-labelledby="reports">
            <li>
                <a class="dropdown-item" href="{{ path('report_index') }}">
                    <i class="fa fa-file" aria-hidden="true"></i> {{ 'menu.reports'|trans }}
                </a>
            </li>
            <li>
                <a class="dropdown-item" href="{{ path('transaction_index') }}">
                    <i class="fa fa-file" aria-hidden="true"></i> {{ 'menu.transactions'|trans }}
                </a>
            </li>
        </ul>    
    </li>  
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown" aria-expanded="false" id="codesheets">
            <i class="fa fa-user" aria-hidden="true"></i>
            {{ 'menu.codesheets'|trans }}
        </a>
        <ul class="dropdown-menu" role="menu" aria-labelledby="codesheets">
            <li>
                <a class="dropdown-item" href="{{ path('organization_index')}}">
                    <i class="fa fa-tasks" aria-hidden="true"></i> {{ 'menu.organizations'|trans }}
                </a>
            </li>
            <li>
                <a class="dropdown-item" href="{{ path('partner_index')}}">
                    <i class="fa fa-tasks" aria-hidden="true"></i> {{ 'menu.clients'|trans }}
                </a>
            </li>            
            <li>
                <a class="dropdown-item" href="{{ path('konto_index') }}">
                    <i class="fa fa-box" aria-hidden="true"></i> {{ 'menu.kontos'|trans }}
                </a>
            </li>            
            <li>
                <a class="dropdown-item" href="{{ path('post_index') }}">
                    <i class="fa fa-mail-bulk" aria-hidden="true"></i> {{ 'menu.posts'|trans }}
                </a>
            </li>
            <li><hr class="dropdown-divider"></li>
            <li>
                <a class="dropdown-item" href="{{ path('country_index') }}">
                    <i class="fa fa-flag" aria-hidden="true"></i> {{ 'menu.countries'|trans }}
                </a>
            </li>
         </ul>
    </li>    
    {{ parent() }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}
