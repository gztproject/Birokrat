{{ include('components/_infinite_list_start.html.twig') }}
<div class="list-table-wrap">
    <table id="lunchExpensesTable" class="table table-hover align-middle">
        <thead>
            <tr>
                <th scope="col"><i class="fa fa-calendar" aria-hidden="true"></i> {{ 'label.date'|trans }}</th>
                <th scope="col" class="text-end"><i class="fa fa-coins" aria-hidden="true"></i> {{ 'label.cost'|trans }}</th>
                {% if ShowCBs is defined and ShowCBs == true%}
                    <th scope="col" class="text-center"><i class="fa fa-check" aria-hidden="true"></i></th>
                {% endif %}
            </tr>
        </thead>
        <tbody{% if infinite|default(false) %} data-infinite-scroll-target="tableBody"{% endif %}>
        {{ include('dashboard/lunchExpense/_rows.html.twig') }}
        </tbody>
    </table>
</div>

<div class="list-cards"{% if infinite|default(false) %} data-infinite-scroll-target="cards"{% endif %}>
    {{ include('dashboard/lunchExpense/_cards.html.twig') }}
</div>
{{ include('components/_infinite_list_end.html.twig') }}

<div id="dateModal" class="modal fade" role="dialog" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h4 class="modal-title">{{ 'label.date'|trans }}</h4>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
            <form>
                <label class="form-label" for="modalDate">{{ 'label.date'|trans }}</label>
                <input id="modalDate" class="form-control" type="text" name="date" data-date-format="DD. MM. YYYY" data-date-locale="sl">
            </form>
      </div>
      <div class="modal-footer">
        <button id="submitDate" type="submit" class="btn btn-success"><i class="fa fa-check" aria-hidden="true"></i> {{ 'action.OK'|trans }}</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'label.close'|trans }}</button>
      </div>
    </div>
  </div>
</div>
