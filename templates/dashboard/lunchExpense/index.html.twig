{% extends 'dashboard/layout.html.twig' %}

{% block body_id 'lunchExpense_index' %}
{% block body_controllers %} expense-bundle{% endblock %}
{% block body_attr %}data-expense-bundle-url-value="/dashboard/lunchExpense/bookInBundle/withFilter"{% endblock %}

{% block toolbar %}
    {{ include('components/_page_header.html.twig', {
        title: 'title.lunchExpenses'|trans,
        count: pagination.getTotalItemCount,
        action_url: path('lunchExpense_new'),
        action_label: 'action.create_lunchExpense'|trans,
        extra_actions: '
            <button type="button" id="bookCheckedTEs" class="btn btn-sm btn-info">' ~ ('action.bookSelectedLunchExpenses'|trans) ~ '</button>
            <button type="button" id="bookVisibleTEs" class="btn btn-sm btn-info" data-action="expense-bundle#bookVisible">' ~ ('action.bookVisibleLunchExpenses'|trans) ~ '</button>
        '
    }) }}
{% endblock %}

{% block filters %}
    {{ include('dashboard/lunchExpense/_filter.html.twig') }}
{% endblock %}

{% block main %}
    <div class="bs-component">
    {{ include('dashboard/lunchExpense/_table.html.twig', {
            lunchExpenses: pagination,
            ShowCBs: true,
            infinite: true,
            page: pagination.currentPageNumber,
            last_page: last_page,
        }, with_context = false) }}
    </div>
{% endblock %}
