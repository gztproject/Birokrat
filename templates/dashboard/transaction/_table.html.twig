{{ include('components/_infinite_list_start.html.twig') }}
<div class="list-table-wrap">
    <table class="table table-hover align-middle">
    <thead>
        <tr>
            <th scope="col" class="col-date"><i class="fa fa-calendar" aria-hidden="true"></i> {{ 'label.date'|trans }}</th>
            <th scope="col" class="d-none d-lg-table-cell"><i class="fa fa-user" aria-hidden="true"></i> {{ 'label.organization'|trans }}</th>
            <th scope="col" class="col-doc"><i class="fa fa-file" aria-hidden="true"></i> {{ 'label.document'|trans }}</th>
            <th scope="col" class="col-sum text-end"><i class="fa fa-euro-sign" aria-hidden="true"></i> {{ 'label.sum'|trans }}</th>
            <th scope="col" class="d-none d-md-table-cell"><i class="fa fa-list-alt " aria-hidden="true"></i> {{ 'label.debit'|trans }}</th>
            <th scope="col" class="d-none d-md-table-cell"><i class="fa fa-list-alt " aria-hidden="true"></i> {{ 'label.credit'|trans }}</th>
            <th scope="col" class="col-actions text-end">{{ 'label.actions'|trans }}</th>
        </tr>
    </thead>
    <tbody{% if infinite|default(false) %} data-infinite-scroll-target="tableBody"{% endif %}>
{{ include('dashboard/transaction/_rows.html.twig') }}
    </tbody>
    </table>
</div>

<div class="list-cards"{% if infinite|default(false) %} data-infinite-scroll-target="cards"{% endif %}>
    {{ include('dashboard/transaction/_cards.html.twig') }}
</div>
{{ include('components/_infinite_list_end.html.twig') }}
