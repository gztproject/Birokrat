{% extends 'dashboard/layout.html.twig' %}

{% block body_id entity ~ '_show' %}

{% block main %}
    {{ include('components/_page_header.html.twig', { title: organization.name }) }}
    <div class="card app-card mb-3"> 
    <div class="card-header">
            <strong>{{ ('label.' ~ entity ~ 'Data')|trans }}</strong>
        </div>    
        <div class="card-body">                    
            <strong>{{ 'label.name'|trans }}</strong>: {{ organization.name }}<br>
            <strong>{{ 'label.email'|trans }}</strong>: {{ organization.email }}<br>
            <strong>{{ 'label.www'|trans }}</strong>: {{ organization.www }}<br>
            <strong>{{ 'label.phone'|trans }}</strong>: {{ organization.phone }}<br>
            <strong>{{ 'label.mobile'|trans }}</strong>: {{ organization.mobile }}<br>
            <strong>{{ 'label.accountNumber'|trans }}</strong>: {{ organization.accountNumber }}<br>
            <strong>{{ 'label.bic'|trans }}</strong>: {{ organization.bic }}
        </div>
    </div>
    
    <div class="card app-card mb-3">   
        <div class="card-header">
            <strong>{{ 'label.address'|trans }}</strong>
        </div> 
        <div class="card-body">            
            <div class="card border-primary mb-3" style="max-width: 15rem;">               
                <div class="card-body">                            
                    {% for line in organization.address.getFullFormattedAddress %}
                        {{ line }}</br>
                    {% endfor %}
                </div>  
            </div>  
        </div>
    </div>
    
    {% if entity == 'organization' %}
    <div class="card app-card mb-3">   
        <div class="card-header">
            <strong>{{ 'label.settings'|trans }}</strong>
        </div>
        <div class="card-body">
        {% if organization.organizationSettings %}
        <table class="table table-hover">
            <thead>
                <tr class="table-primary">
                    <th scope="col">{{ 'label.setting'|trans }}</th>
                    <th scope="col">{{ 'label.value'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                <tr class="table-primary">
                    <td>{{ 'label.invoicePrefix'|trans }}</td>
                    <td>{{ organization.organizationSettings.invoicePrefix | default("") }}</td>
                </tr>     
                <tr class="table-primary">
                    <td>{{ 'label.defaultPaymentDueIn'|trans }}</td>
                    <td>{{ organization.organizationSettings.defaultPaymentDueIn | default("") }}</td>
                </tr>
                <tr class="table-primary">
                    <td>{{ 'label.referenceModel'|trans }}</td>
                    <td>{{ organization.organizationSettings.referenceModel | default("") }}</td>
                </tr>
                <tr>
                    <td>{{ 'label.travelExpenseRate'|trans }}</td>
                    <td>{{ organization.organizationSettings.travelExpenseRate | default("") }}</td>
                </tr>
                <tr>
                    <td>{{ 'label.autoCreatePerDiem'|trans }}</td>
                    <td>{{ organization.organizationSettings.autoCreatePerDiem ? 'label.yes'|trans : 'label.no'|trans }}</td>
                </tr>
                <tr>
                    <td>{{ 'label.perDiemValue'|trans }}</td>
                    <td>{{ organization.organizationSettings.perDiemValue | default("") }}</td>
                </tr>
                <tr>
                    <td>{{ 'label.autoCreateLunch'|trans }}</td>
                    <td>{{ organization.organizationSettings.autoCreateLunch ? 'label.yes'|trans : 'label.no'|trans }}</td>
                </tr>
                <tr>
                    <td>{{ 'label.lunchValue'|trans }}</td>
                    <td>{{ organization.organizationSettings.lunchValue | default("") }}</td>
                </tr>
            </tbody>
        </table>
        {% endif %}
      </div>    
    </div>
    {% endif %}

{% endblock %}

{% block sidebar %}
    <div class="section">
        <a href="{{ path(entity ~ '_edit', {id: organization.id}) }}" class="btn btn-sm w-100 btn-success">
            <i class="fa fa-edit" aria-hidden="true"></i> {{ 'action.edit_contents'|trans }}
        </a>
    </div>
    {% if entity == 'organization' %}
    <div class="section">
        <a href="{{ path('organization_settings_edit', {id: organization.id}) }}" class="btn btn-sm w-100 btn-primary">
            <i class="fa fa-cog" aria-hidden="true"></i> {{ 'action.edit_settings'|trans }}
        </a>
    </div>
    {% endif %}

    <div class="section">
        {{ include('dashboard/organization/_delete_form.html.twig', {organization: organization, entity: entity}, with_context = false) }}
    </div>

    {{ parent() }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}  