{% extends 'dashboard/layout.html.twig' %}

{% block body_id 'organization_edit' %}

{% block toolbar %}
    <div class="page-toolbar">
        <h1 class="page-title">{{ 'title.organization_edit'|trans({'%organization%': organization.name}) }}</h1>
        <div class="page-toolbar-actions">
            <a href="{{ path('organization_show', {id: organization.id}) }}" class="btn btn-sm btn-outline-secondary">
                <i class="fa fa-eye" aria-hidden="true"></i> {{ 'action.show_organization'|trans }}
            </a>
            {{ include('dashboard/organization/_delete_form.html.twig', {organization: organization, entity: entity}, with_context = false) }}
        </div>
    </div>
{% endblock %}

{% block main %}
    {{ include('dashboard/organization/_form.html.twig', {
        form: form,
        entity: entity,
        button_label: 'action.save'|trans,
        include_back_to_home_link: true,
    }, with_context = false) }}
{% endblock %}
