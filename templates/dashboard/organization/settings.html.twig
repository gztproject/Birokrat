{% extends 'dashboard/layout.html.twig' %}

{% block body_id 'organization_settings_edit' %}

{% block toolbar %}
    <div class="page-toolbar">
        <h1 class="page-title">{{ 'title.organization_settings'|trans({organization: organization.name}) }}</h1>
        <div class="page-toolbar-actions">
            <a href="{{ path('organization_show', {id: organization.id}) }}" class="btn btn-sm btn-outline-secondary">
                <i class="fa fa-eye" aria-hidden="true"></i> {{ 'action.show_organization'|trans }}
            </a>
        </div>
    </div>
{% endblock %}

{% block main %}
    {{ include('dashboard/organization/_settings_form.html.twig', {
        form: form,
        organization: organization,
    }, with_context = false) }}
{% endblock %}
