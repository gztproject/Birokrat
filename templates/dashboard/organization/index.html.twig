{% extends 'dashboard/layout.html.twig' %}

{% block body_id entity ~ '_index' %}

{% block toolbar %}
    {{ include('components/_page_header.html.twig', {
        title: 'title.organization_list'|trans,
        action_url: path(entity ~ '_new'),
        action_label: ('action.create_' ~ entity)|trans
    }) }}
{% endblock %}

{% block main %}
    <div class="list-table-wrap">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th scope="col">{{ 'label.name'|trans }}</th>
                        <th scope="col" class="d-none d-lg-table-cell">{{ 'label.address'|trans }}</th>
                        <th scope="col">{{ 'label.taxNumber'|trans }}</th>
                        <th scope="col" class="d-none d-md-table-cell">{{ 'label.taxable'|trans }}</th>
                        <th scope="col" class="text-end">{{ 'label.actions'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                {% for organization in organizations %}
                    <tr>
                        <td>{{ organization.name }}</td>
                        <td class="d-none d-lg-table-cell">{{ organization.address.fullAddress }}</td>
                        <td>{{ organization.fullTaxNumber }}</td>
                        <td class="d-none d-md-table-cell">{% if organization.taxable %}<i class="fa fa-check" aria-hidden="true"></i>{% endif %}</td>
                        <td class="text-end">
                            <div class="item-actions">
                                <a href="{{ path(entity ~ '_show', {'id': organization.id}) }}" class="btn btn-sm btn-secondary">{{ 'action.show'|trans }}</a>
                                <a href="{{ path(entity ~ '_edit', {'id': organization.id}) }}" class="btn btn-sm btn-primary">{{ 'action.edit'|trans }}</a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    {{ include('components/_empty_state.html.twig', { colspan: 5, message: (entity ~ '.no_' ~ entity ~ 's_found')|trans }) }}
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="list-cards">
        {% for organization in organizations %}
            <div class="list-card">
                <div>
                    <div class="list-card-title">{{ organization.name }}</div>
                    <div class="list-card-sub">{{ organization.fullTaxNumber }}</div>
                    <div class="list-card-meta">{{ organization.address.fullAddress }}</div>
                </div>
                <div class="list-card-actions">
                    <a href="{{ path(entity ~ '_show', {'id': organization.id}) }}" class="btn btn-sm btn-secondary">{{ 'action.show'|trans }}</a>
                    <a href="{{ path(entity ~ '_edit', {'id': organization.id}) }}" class="btn btn-sm btn-primary">{{ 'action.edit'|trans }}</a>
                </div>
            </div>
        {% else %}
            <div class="empty-state">{{ (entity ~ '.no_' ~ entity ~ 's_found')|trans }}</div>
        {% endfor %}
    </div>
{% endblock %}
