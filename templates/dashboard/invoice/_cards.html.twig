{% for invoice in invoices %}
    {% if invoice.State == 00 or invoice.State == 10 %}
        {% set status = "draft" %}
    {% elseif invoice.State == 20 %}
        {% if date() > invoice.dueDate|date_modify("+1 day") %}
            {% set status = "overdue" %}
        {% else %}
            {% set status = "issued" %}
        {% endif %}
    {% elseif invoice.State == 30 %}
        {% set status = "paid" %}
    {% elseif invoice.State == 40 %}
        {% set status = "cancelled" %}
    {% else %}
        {% set status = "issued" %}
    {% endif %}
    <div data-id="{{ invoice.id }}" class="list-card invoiceRow" data-action="click->document-action#openRow">
        <div>
            <div class="list-card-title">
                {% if invoice.state == 10 %} {{ 'label.draft'|trans }} {% elseif invoice.state == 40 %} {{ 'label.cancelled'|trans }} {% else %} {{ invoice.number }} {% endif %}
                {{ include('components/_status_badge.html.twig', { status: status }) }}
            </div>
            <div class="list-card-sub">{{ invoice.Recepient.ShortName }} · {{ invoice.dateOfIssueString }}</div>
            <div class="list-card-meta">
                {% if invoice.datePaid %}{{ invoice.DatePaidString }}{% else %}{{ invoice.DueDateString }}{% endif %}
            </div>
        </div>
        <div class="list-card-amount">{{ invoice.TotalPrice | money }}</div>
        <div class="list-card-actions">
            {% embed 'components/_action_menu.html.twig' %}
                {% block primary %}
                    {% if invoice.State == 10 %}
                        <a href="{{ path('invoice_edit', {'id': invoice.id}) }}" class="btn btn-sm btn-primary">
                            <i class="fa fa-edit" aria-hidden="true"></i> {{ 'action.edit'|trans }}
                        </a>
                        <button class="set-issued btn btn-sm btn-success" type="button" name="id" value={{ invoice.id }} data-action="click->document-action#issue">
                            {{ 'action.setIssued'|trans }}
                        </button>
                    {% endif %}
                    {% if invoice.State == 20 %}
                        <button class="set-paid btn btn-sm btn-success" type="button" name="id" value={{ invoice.id }} data-action="click->document-action#pay">
                            {{ 'action.setPaid'|trans }}
                        </button>
                    {% endif %}
                {% endblock %}
                {% block more %}
                    {% if invoice.State == 00 or invoice.State == 10 %}
                    <li>
                        <button class="dropdown-item cancel" type="button" name="id" value={{ invoice.id }} data-action="click->document-action#cancel">
                            {{ 'action.cancel'|trans }}
                        </button>
                    </li>
                    {% endif %}
                    <li>
                        <a class="dropdown-item" href="{{ path('invoice_show', {'id': invoice.id}) }}">{{ 'action.show'|trans }}</a>
                    </li>
                    <li>
                        <a class="dropdown-item" href="{{ path('invoice_print', {'id': invoice.id}) }}" target="_blank">{{ 'action.print'|trans }}</a>
                    </li>
                    <li>
                        <a class="dropdown-item" href="{{ path('invoice_clone', {'id': invoice.id}) }}">{{ 'action.clone'|trans }}</a>
                    </li>
                {% endblock %}
            {% endembed %}
        </div>
    </div>
{% else %}
    {% if empty|default(true) %}
        <div class="empty-state">{{ 'invoice.no_invoices_found'|trans }}</div>
    {% endif %}
{% endfor %}
