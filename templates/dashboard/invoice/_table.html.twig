{{ include('components/_infinite_list_start.html.twig') }}
<div class="list-table-wrap">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th scope="col" class="col-number">{{ 'label.invoiceNumber'|trans }}</th>
                <th scope="col" class="col-date"><i class="fa fa-calendar" aria-hidden="true"></i> {{ 'label.dateOfIssue'|trans }}</th>
                <th scope="col" class="col-party">{{ 'label.recepient'|trans }}</th>
                <th scope="col" class="d-none d-lg-table-cell">{{ 'label.reference'|trans }}</th>
                <th scope="col" class="col-sum text-end">{{ 'label.sum'|trans }}</th>
                <th scope="col" class="d-none d-md-table-cell">{{ 'label.dueDate'|trans }}/{{ 'label.paid'|trans }}</th>
                <th scope="col" class="col-actions text-end">{{ 'label.actions'|trans }}</th>
            </tr>
        </thead>
        <tbody{% if infinite|default(false) %} data-infinite-scroll-target="tableBody"{% endif %}>
            {{ include('dashboard/invoice/_rows.html.twig') }}
        </tbody>
    </table>
</div>

<div class="list-cards"{% if infinite|default(false) %} data-infinite-scroll-target="cards"{% endif %}>
    {{ include('dashboard/invoice/_cards.html.twig') }}
</div>
{{ include('components/_infinite_list_end.html.twig') }}

{{ include('dashboard/invoice/_dateModal.html.twig')}}
