{% extends 'dashboard/layout.html.twig' %}

{% block body_id 'invoice_index' %}

{% block toolbar %}
    {{ include('components/_page_header.html.twig', {
        title: 'title.invoices'|trans,
        count: pagination.getTotalItemCount,
        action_url: path('invoice_new'),
        action_label: 'action.create_invoice'|trans
    }) }}
{% endblock %}

{% block main %}
    <div class="bs-component" data-controller="document-action" data-document-action-show-prefix-value="invoice">
    {{ include('dashboard/invoice/_table.html.twig', {
            invoices: pagination,
            infinite: true,
            page: pagination.currentPageNumber,
            last_page: last_page,
        }, with_context = false) }}
    </div>
{% endblock %}
