<div id="dateModal" class="modal fade" role="dialog" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h4 class="modal-title">{{ 'label.date'|trans }}</h4>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="row">
            <form>
                {{ 'label.date'|trans }}:<br>
                <input id="modalDate" class="form-control" type="date" name="date">
                <input id="dateId" type="hidden" name="id">
                {{ 'label.bankCost'|trans }}:<br>
                <input id="modalBankCost" class="form-control" type="number" step="0.01" name="bankCost" value="0">
            </form>
        </div>
      </div>
      <div class="modal-footer">
        <button id="submitDate" type="button" class="btn btn-success"><i class="fa fa-check" aria-hidden="true"></i> {{ 'action.OK'|trans }}</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'label.close'|trans }}</button>
      </div>
    </div>
  </div>
</div>
