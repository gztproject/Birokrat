<table class="table table-hover">
    <thead>
        <tr class='table-primary'>
            <th scope="col"><i aria-hidden="true"></i> {{ 'label.name'|trans }}</th>
            <th scope="col"><i aria-hidden="true"></i> {{ 'label.sum'|trans }}</th>
            <th scope="col"><i aria-hidden="true"></i> {{ 'label.name'|trans }}</th>
            <th scope="col"><i aria-hidden="true"></i> {{ 'label.sum'|trans }}</th>
    </thead>
    <tbody>        
         <tr class="table-default">
            <td rowspan="4">Prihodki</td>
            <td rowspan="4">{{ report.income|money_amount }} €</td>
            <td>Izdani računi{% for number, name in report.invoicesKontos %} <span class="badge rounded-pill text-bg-info kontoInfo" title="{{ name }}">{{ number }}</span>{% endfor %}</td>
            <td>{{ report.invoices|money_amount }} €</td>
         </tr>
         <tr class="table-default">           
            <td>Obdavčljive subvencije, nadomestila...{% for number, name in report.taxableSubventionsKontos %} <span class="badge rounded-pill text-bg-info kontoInfo" title="{{ name }}">{{ number }}</span>{% endfor %}</td>
            <td>{{ report.taxableSubventions|money_amount }} €</td>
         </tr>
        
         <tr class="table-default">           
            <td>Ostalo{% for number, name in report.otherIncomesKontos %} <span class="badge rounded-pill text-bg-info kontoInfo" title="{{ name }}">{{ number }}</span>{% endfor %}</td>
            <td>{{ report.otherIncomes|money_amount }} €</td>
         </tr>
          <tr class="table-default">           
            <td>Neobdavčljive subvencije, nadomestila...  {% for number, name in report.otherSubventionsKontos %} <span class="badge rounded-pill text-bg-info kontoInfo" title="{{ name }}">{{ number }}</span>{% endfor %}</td>
            <td>{{ report.otherSubventions|money_amount }} €</td>
         </tr>
         
         
         
         <tr class="table-default">
            <td rowspan = "5">Odhodki</td>
            <td rowspan = "5">{{ report.expenses|money_amount }} €</td>
            <td>Prejeti računi{% for number, name in report.incomingInvoicesKontos %} <span class="badge rounded-pill text-bg-info kontoInfo" title="{{ name }}">{{ number }}</span>{% endfor %}</td>
            <td>{{ report.incomingInvoices|money_amount }} €</td>
         </tr>
         <tr class="table-default">
            <td>Prispevki{% for number, name in report.socialSecurityKontos %} <span class="badge rounded-pill text-bg-info kontoInfo" title="{{ name }}">{{ number }}</span>{% endfor %}</td>
            <td>{{ report.socialSecurity|money_amount }} €</td>
         </tr>
         <tr class="table-default">
            <td>Potni stroški, prehrana{% for number, name in report.dailyExpensesKontos %} <span class="badge rounded-pill text-bg-info kontoInfo" title="{{ name }}">{{ number }}</span>{% endfor %}</td>
            <td>{{ report.dailyExpenses|money_amount }} €</td>
         </tr>         
         <tr class="table-default">
            <td>Drugi stroški{% for number, name in report.otherKontos %} <span class="badge rounded-pill text-bg-info kontoInfo" title="{{ name }}">{{ number }}</span>{% endfor %}</td>
            <td>{{ report.other|money_amount }} €</td>
         </tr>
         <tr class="table-secondary">
            <td><span class="badge rounded-pill text-bg-danger">Neobdavčeno</span> Dohodnina{% for number, name in report.incomeTaxKontos %} <span class="badge rounded-pill text-bg-info kontoInfo" title="{{ name }}">{{ number }}</span>{% endfor %}</td>
            <td>{{ report.incomeTax|money_amount }} €</td>
         </tr>  
         <tr class="table-default">
            <td rowspan="3">Stanje</td>
            <td rowspan = "3">{{ report.outcome|money_amount }} €</td>
            <td>TRR</td>
            <td>{{ report.bank|money_amount }} €</td>
         </tr>
         <tr class="table-default">
            <td>Dolgovi</td>
            <td>{{ report.debts|money_amount }} €</td>
         </tr>
         <tr class="table-default">
            <td>Gotovina</td>
            <td>{{ report.cash|money_amount }} €</td>
         </tr>
    </tbody>
</table>
