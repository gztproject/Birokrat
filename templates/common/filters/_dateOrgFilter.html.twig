<form class="bs-component" data-controller="org-filter" data-action="submit->org-filter#apply">
    <fieldset class="form-group">
         <div class="form-group">
            <label class="col-form-label-lg" for="organizationPicker">{{ 'label.organization'|trans }}</label>
            <select id="organizationPicker" class="form-control" name="organization" data-org-filter-target="organization" data-action="change->org-filter#onOrganizationChange"></select>
         </div>
    </fieldset>
    <fieldset class="form-group">
        <label class="col-form-label-lg" for="dateFieldFrom">{{ 'label.dateFrom'|trans }}</label>
        <input type="date" id="dateFieldFrom" class="form-control" data-org-filter-target="from" data-action="change->org-filter#onFromChange">
        <label class="col-form-label-lg" for="dateFieldTo">{{ 'label.dateTo'|trans }}</label>
        <input type="date" id="dateFieldTo" class="form-control" data-org-filter-target="to" data-action="change->org-filter#onToChange">
    </fieldset>
    <fieldset class="form-group">
        <button type="button" id="clearFilterBtn" class="btn btn-danger" data-action="org-filter#clear">{{ 'label.clear' | trans }}</button>
    </fieldset>
</form>
