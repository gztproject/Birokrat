{% extends 'dashboard/layout.html.twig' %}

{% block body_id 'two_factor_setup' %}

{% block main %}
    {{ include('components/_page_header.html.twig', { title: 'label.totp'|trans }) }}
    {% if error %}
        <div class="alert alert-danger">{{ error }}</div>
    {% endif %}
    <div class="card app-card">
        <div class="card-body">
            {% if enabled %}
                <p class="mb-3">Two-factor authentication is enabled.</p>
                <form method="post">
                    <button type="submit" name="disable" value="1" class="btn btn-danger">Disable 2FA</button>
                </form>
            {% else %}
                <p>Scan this URI in an authenticator app, or enter the secret manually, then confirm with a code.</p>
                <p><code>{{ secret }}</code></p>
                <p class="text-muted small">{{ uri }}</p>
                <form method="post">
                    <div class="mb-3">
                        <label class="form-label" for="code">{{ 'label.totpCode'|trans }}</label>
                        <input id="code" name="code" class="form-control" inputmode="numeric" autocomplete="one-time-code" required>
                    </div>
                    <button type="submit" class="btn btn-primary">Enable 2FA</button>
                </form>
            {% endif %}
        </div>
    </div>
{% endblock %}
