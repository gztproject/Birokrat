{% extends 'base.html.twig' %}

{% block body_id 'two_factor' %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-5 col-lg-4">
            {% if error %}
                <div class="alert alert-danger">{{ error }}</div>
            {% endif %}
            <div class="card auth-card mb-3">
                <div class="card-header">
                    <h1 class="h4 mb-0">{{ 'label.totp'|trans }}</h1>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div class="mb-3">
                            <label class="form-label" for="code">{{ 'label.totpCode'|trans }}</label>
                            <input id="code" name="code" class="form-control" inputmode="numeric" autocomplete="one-time-code" required>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">{{ 'action.sign_in'|trans }}</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
