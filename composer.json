{
	"name" : "gzt/birokrat",
	"type" : "project",
	"license" : "MIT",
	"description" : "A DIY web-based accounting software",
	"require" : {
		"php" : "^8.4",
		"ext-ctype" : "*",
		"ext-iconv" : "*",
		"doctrine/doctrine-bundle" : "^3.0",
		"doctrine/doctrine-migrations-bundle" : "^3.3",
		"doctrine/orm" : "^3.3",
		"erusev/parsedown" : "~1.7",
		"ezyang/htmlpurifier" : "~4.14",
		"friendsofsymfony/jsrouting-bundle" : "^3.5",
		"knplabs/knp-paginator-bundle" : "^6.4",
		"nelmio/cors-bundle" : "^2.5",
		"phpdocumentor/reflection-docblock" : "~5.3",
		"phpoffice/phpspreadsheet" : "~1.22",
		"phpstan/phpdoc-parser" : "~1.2",
		"qipsius/tcpdf-bundle" : "^4.0",
		"ramsey/uuid" : "^4.7",
		"ramsey/uuid-doctrine" : "^2.0",
		"symfony/apache-pack" : "~1.0",
		"symfony/asset" : "8.1.*",
		"symfony/console" : "8.1.*",
		"symfony/dotenv" : "8.1.*",
		"symfony/expression-language" : "8.1.*",
		"symfony/flex" : "^2.4",
		"symfony/form" : "8.1.*",
		"symfony/framework-bundle" : "8.1.*",
		"symfony/http-client" : "8.1.*",
		"symfony/mailer" : "8.1.*",
		"symfony/mailgun-mailer" : "8.1.*",
		"symfony/monolog-bundle" : "^4.0",
		"symfony/process" : "8.1.*",
		"symfony/property-access" : "8.1.*",
		"symfony/property-info" : "8.1.*",
		"symfony/runtime" : "8.1.*",
		"symfony/security-bundle" : "8.1.*",
		"symfony/serializer" : "8.1.*",
		"symfony/translation" : "8.1.*",
		"symfony/twig-bundle" : "8.1.*",
		"symfony/validator" : "8.1.*",
		"symfony/web-link" : "8.1.*",
		"symfony/webpack-encore-bundle" : "^2.3",
		"symfony/yaml" : "8.1.*",
		"tecnickcom/tcpdf" : "^6.6",
		"twig/extra-bundle" : "^3.8",
		"twig/intl-extra" : "^3.8"
	},
	"require-dev" : {
		"doctrine/doctrine-fixtures-bundle" : "^4.1",
		"phpunit/phpunit" : "^13.3",
		"symfony/browser-kit" : "8.1.*",
		"symfony/css-selector" : "8.1.*",
		"symfony/debug-bundle" : "8.1.*",
		"symfony/maker-bundle" : "^1.50",
		"symfony/phpunit-bridge" : "8.1.*",
		"symfony/stopwatch" : "8.1.*",
		"symfony/web-profiler-bundle" : "8.1.*"
	},
	"config" : {
		"preferred-install" : {
			"*" : "dist"
		},
		"sort-packages" : true,
		"platform" : {
			"php" : "8.4.99"
		},
		"allow-plugins" : {
			"symfony/flex" : true,
			"symfony/runtime" : true
		}
	},
	"autoload" : {
		"psr-4" : {
			"App\\" : "src/"
		}
	},
	"autoload-dev" : {
		"psr-4" : {
			"App\\Tests\\" : "tests/"
		}
	},
	"scripts" : {
		"auto-scripts" : {
			"cache:clear" : "symfony-cmd",
			"assets:install %PUBLIC_DIR%" : "symfony-cmd"
		},
		"post-install-cmd" : [
			"@auto-scripts"
		],
		"post-update-cmd" : [
			"@auto-scripts"
		],
		"test" : "php vendor/bin/phpunit --no-coverage"
	},
	"replace" : {
		"paragonie/random_compat" : "2.*",
		"symfony/polyfill-ctype" : "*",
		"symfony/polyfill-iconv" : "*",
		"symfony/polyfill-php72" : "*",
		"symfony/polyfill-php73" : "*",
		"symfony/polyfill-php74" : "*",
		"symfony/polyfill-php80" : "*",
		"symfony/polyfill-php82" : "*",
		"symfony/polyfill-php83" : "*",
		"symfony/polyfill-php84" : "*"
	},
	"conflict" : {
		"symfony/symfony" : "*"
	},
	"extra" : {
		"symfony" : {
			"allow-contrib" : false,
			"require" : "8.1.*"
		}
	},
	"support" : {
		"email" : "info@gzt.si",
		"issues" : "https://github.com/gztproject/Birokrat/issues",
		"wiki" : "https://github.com/gztproject/Birokrat/wiki"
	},
	"minimum-stability" : "stable",
	"authors" : [{
			"name" : "Gašper Doljak",
			"email" : "gasper@gzt.si",
			"homepage" : "https://www.gzt.si",
			"role" : "Main dev"
		}
	]
}
